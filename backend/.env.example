# Application
PORT=3000
NODE_ENV=production

# Kingdee
KINGDEE_BASE_URL=
KINGDEE_ERP_ACCOUNT=
KINGDEE_USERNAME=
KINGDEE_PASSWORD=
KINGDEE_LANGUAGE_ID=1033
KINGDEE_LOGIN_TYPE=1

# Local database used by the existing Kingdee/serial data pipeline.
# This is NOT used for standalone password storage.
DATABASE_PATH=./data/kingdee.db

# DingTalk SSO
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
DINGTALK_CORP_ID=
DINGTALK_AGENT_ID=

# EKSBASE standalone administrator
EKSBASE_ADMIN_EMPLOYEE_NO=
EKSBASE_ADMIN_PASSWORD=
EKSBASE_SESSION_SECRET=

# GitHub private credential store
# Never commit the token to source control.
GITHUB_CREDENTIALS_TOKEN=
GITHUB_CREDENTIALS_REPO=emmanendayarealmeph-cpu/eksbase-private-credentials
GITHUB_CREDENTIALS_PATH=data/standalone-credentials.json
